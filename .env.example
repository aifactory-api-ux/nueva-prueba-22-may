# Application Environment
NODE_ENV=development
PORT=23001
API_PORT=23001

# Application name for health checks
APP_NAME=ecommerce-api

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:24000

# Database Configuration
DATABASE_HOST=postgres
DATABASE_PORT=25432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=ecommerce
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=5

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=26379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=ecommerce:
REDIS_TTL=604800
REDIS_CONNECT_TIMEOUT=10000
REDIS_RETRY_ATTEMPTS=3
REDIS_RETRY_DELAY=1000

# JWT Configuration
JWT_SECRET=change-this-secret-in-production-min-32-chars
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production-min-32-chars

# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend URL (used for Stripe redirects)
FRONTEND_URL=http://localhost:24000